# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EITAA_BOT_TOKEN: The bot token provided by Eitaa (from BotFather)
# Used on the server-side to cryptographically verify user registration and login data.
# Leave empty in development to bypass strict validation.
EITAA_BOT_TOKEN=""

# MONGODB_URI: MongoDB connection string (e.g. from MongoDB Atlas).
# When set, all application data (users, inboxes, messages, subscriptions, tickets,
# settings and attachments) is persisted in MongoDB instead of local JSON files.
MONGODB_URI=""
MONGODB_DB="jabeja_email"

# Security & Secret Configurations
JWT_SECRET="change-me-to-a-long-random-string"
ADMIN_INITIAL_PASSWORD=""
BLUPAL_API_KEY=""
BLUPAL_MERCHANT_ID=""
BLUPAL_TERMINAL_ID=""
BLUPAL_MODE="sandbox"
INBOUND_WEBHOOK_SECRET=""
TELEGRAM_WEBHOOK_SECRET=""
EITAA_STRICT_VERIFY="false"
ADMIN_AUTH_ENABLED="false"
ALLOWED_ORIGINS="https://ja-be-ja.ir,https://www.ja-be-ja.ir"
